<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Account</fullName><active
  >true</active><errorConditionFormula
  >AND(Active__c, ISBLANK(User_Id__c), ISBLANK(Username__c))</errorConditionFormula><errorMessage
  >Enter a User ID or exact username for an active exclusion.</errorMessage>
</ValidationRule>
